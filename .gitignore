# Dependencies
node_modules/

# Gatsby
.cache/
public/

# Build
build/

# Env — never commit
.env*

# Amplify — never commit
# The modeler is a frontend-only consumer; the portal owns the backend.
# `amplify` here is typically a symlink created by scripts/sync-env.sh
# pointing at the umbrella's master copy — git sees it as a file, so the
# entry has no trailing slash to match symlinks too.
amplify
src/aws-exports.js
.graphqlconfig.yml

# Auto-generated by Amplify Studio / `amplify codegen` — do not hand-edit
src/ui-components/

# Real SmartHome instances — contain personal address data, keep local only
# Demo instances (*-DEMO-*.ttl) are safe to commit
semantic-core/instances/DE-[0-9]*.ttl
semantic-core/instances/FR-[0-9]*.ttl
semantic-core/instances/BE-[0-9]*.ttl

# IDE
.vscode/

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

