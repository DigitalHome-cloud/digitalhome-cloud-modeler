# Dependencies
node_modules/

# Gatsby
.cache/
public/

# Build
build/

# Env — never commit
.env*

# Amplify Gen 2 — local sandbox state, never commit
.amplify/
# (amplify_outputs.json IS committed — it holds the public Cognito/AppSync IDs
# that the frontend needs to talk to the deployed backend.)

# Legacy Gen 1 leftovers (kept ignored just in case any old branch still
# references these paths)
src/aws-exports.js
src/aws-exports.deployment.js
.graphqlconfig.yml

# Auto-generated by Amplify Studio — do not hand-edit
src/ui-components/

# Real SmartHome instances — contain personal address data, keep local only
# Demo instances (*-DEMO-*.ttl) are safe to commit
semantic-core/instances/DE-[0-9]*.ttl
semantic-core/instances/FR-[0-9]*.ttl
semantic-core/instances/BE-[0-9]*.ttl

# IDE
.vscode/

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
